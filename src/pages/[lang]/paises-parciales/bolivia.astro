---
export function getStaticPaths() {
  return [
    { params: { lang: 'es', pais: 'bolivia' } },
    { params: { lang: 'pt', pais: 'bolivia' } },
  ];
}

import { t } from '../../../i18n/utils.ts';

const { lang } = Astro.params;
const locale = lang === 'pt' ? 'pt' : 'es';
---

<div class="p-6 bg-white border-2 border-gray-200 rounded-lg">
  <h2 class="text-2xl font-bold text-cafeoscuro mb-4">{t('pais.bolivia.titulo', locale)}</h2>
  <p class="text-gray-600">{t('pais.bolivia.descripcion', locale)}</p>
  <ul class="mt-4 space-y-2">
    <li>• {t('pais.bolivia.item1', locale)}</li>
    <li>• {t('pais.bolivia.item2', locale)}</li>
    <li>• {t('pais.bolivia.item3', locale)}</li>
    <li>• {t('pais.bolivia.item4', locale)}</li>
  </ul>
</div>
